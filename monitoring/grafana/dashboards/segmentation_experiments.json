          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  AVG(CASE WHEN cluster_mode='legacy' THEN total_latency_ms END)::numeric /\n  NULLIF(AVG(CASE WHEN cluster_mode='homogen' THEN total_latency_ms END)::numeric, 0) AS speedup\nFROM segmentation_experiments\nWHERE status='completed'\n  AND created_at > NOW() - INTERVAL '1 day';",
          "refId": "A"
        }
      ],
      "title": "Speedup Ratio (Baseline vs Distributed Workers)",
      "type": "stat"
